# AI Software Company - Environment Variables
# Copy this file to .env and fill in your actual keys

# --- LLM Providers ---
APMIX_API_KEY=
APMIX_BASE_URL=https://api.apmix.ai/v1
APMIX_MODEL=claude-sonnet-4-6-free

GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENROUTER_API_KEY=

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_USERNAME=

# --- App Config ---
APP_ENV=dev
DEBUG=True
DATABASE_URL=sqlite:///./ai_company.db
REDIS_URL=redis://127.0.0.1:6379
CHROMA_URL=http://127.0.0.1:8888

# --- Security ---
SESSION_SECRET=change-me-to-a-random-string
SESSION_LIFETIME_HOURS=24
KEEP_WORKSPACE=1
